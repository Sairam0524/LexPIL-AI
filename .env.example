# LexPIL AI Environment Configuration

# Database
DATABASE_URL=postgresql://lexpil:password@localhost:5432/lexpil
NEO4J_URL=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ChromaDB
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_BASE_URL=https://api.openai.com/v1

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Application
APP_ENV=development
APP_DEBUG=false
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Corpus Ingestion
CORPUS_UPDATE_HOUR=00
CORPUS_UPDATE_MINUTE=00
CORPUS_BATCH_SIZE=100
CORPUS_EMBEDDING_BATCH_SIZE=50

# News Service
NEWS_UPDATE_INTERVAL_HOURS=6
NEWS_RETENTION_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Email (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Embedding Settings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
